# Herasat Whistleblowing Portal - Complete Environment Configuration Template
# COPY THIS FILE TO .env AND POPULATE WITH SECURE, PRODUCTION VALUES.

# Cryptographic Keys (MANDATORY - generate 32 random bytes; must be distinct and non-placeholder)
# e.g.: openssl rand -hex 16 (or 32 hex chars / 32 raw bytes)
HERASAT_AES_KEY=
HERASAT_HMAC_KEY=
HERASAT_KEY_ID=k1
HERASAT_AES_KEY_PREVIOUS=

# Database Connection (MANDATORY - PostgreSQL native connection string or URL)
HERASAT_DB_CONN=host=127.0.0.1 port=5432 user=herasat_user password=your_secure_password dbname=herasat_db sslmode=disable

# Initial Admin Bootstrap (Optional; if unset and no superuser exists, random 24-char password printed to stdout)
HERASAT_INITIAL_ADMIN_USERNAME=admin
HERASAT_INITIAL_ADMIN_PASSWORD=
HERASAT_INITIAL_ADMIN_FULL_NAME=مدیر ارشد سامانه

# Network & Bind Configuration
HERASAT_BIND_ADDR=0.0.0.0:8080
HERASAT_PORT=8080
HERASAT_ALLOWED_HOSTS=
HERASAT_ALLOWED_ORIGINS=https://admin.herasat.local

# TLS Termination (Direct)
HERASAT_TLS_CERT=
HERASAT_TLS_KEY=

# Cookie & Reverse Proxy Security
HERASAT_COOKIE_SECURE=true
HERASAT_TRUSTED_PROXIES=
HERASAT_REQUIRE_HTTPS=false

# Admin Panel Network Segmentation (MANDATORY - comma-separated CIDR list, e.g. 127.0.0.1/32,10.0.0.0/8)
HERASAT_ADMIN_ALLOWED_CIDRS=
HERASAT_ADMIN_ALLOW_ANY=false

# Authentication, 2FA & Lockout Controls
HERASAT_REQUIRE_2FA=false
HERASAT_TWO_PERSON_DELETION=false

# Content Moderation & Reporting
HERASAT_PROFANITY_ACTION=flag

# Audit Chain Verification (1 = fail startup if HMAC chain verification detects discrepancy)
HERASAT_AUDIT_STRICT=0

# ClamAV Antivirus Daemon Integration
HERASAT_CLAMAV_ENABLED=true
HERASAT_CLAMAV_ADDR=127.0.0.1:3310
HERASAT_CLAMAV_TIMEOUT=10s
HERASAT_CLAMAV_REQUIRED=false
HERASAT_CLAMAV_DISABLED=false

# Automated Encrypted Backups
HERASAT_BACKUP_ENABLED=true
HERASAT_BACKUP_DIR=./backups
HERASAT_BACKUP_INTERVAL_HOURS=24
HERASAT_BACKUP_RETENTION_DAYS=14
HERASAT_DOCKER_CONTAINER=herasat_postgres

# Upload Pipeline & DoS Limiter
HERASAT_MAX_CONCURRENT_UPLOADS=10

# Subprocess & Python Runtime (Optional path to custom python executable)
HERASAT_PYTHON_BIN=

# Remote Syslog / SIEM Audit Exporter (RFC 5424)
HERASAT_SYSLOG_ENABLED=false
HERASAT_SYSLOG_NETWORK=udp
HERASAT_SYSLOG_ADDR=192.168.10.50:514

# Development Mode Escape Hatch (1 = dev mode; disables strict startup gates with loud warnings)
HERASAT_DEV_MODE=0
